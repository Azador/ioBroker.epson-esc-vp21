{
  "name": "iobroker.epson-esc-vp21",
  "version": "0.3.0-alpha.0",
  "description": "Adapter for Epson projectors with ESC/VP21 support via WiFi (e.g. EH-TW5650)",
  "author": {
    "name": "Azador",
    "email": "github@lobo.uber.space"
  },
  "contributors": [
    {
      "name": "Azador"
    }
  ],
  "homepage": "https://github.com/Azador/ioBroker.epson-esc-vp21",
  "license": "MIT",
  "keywords": [
    "epson",
    "projector",
    "wifi",
    "iobroker",
    "esc-vp21",
    "iobroker-adapter"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Azador/ioBroker.epson-esc-vp21.git"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@iobroker/adapter-core": "^3.4.3"
  },
  "devDependencies": {
    "@alcalzone/release-script": "^5.2.1",
    "@alcalzone/release-script-plugin-iobroker": "^5.2.0",
    "@alcalzone/release-script-plugin-license": "^5.2.2",
    "@eslint/js": "^10.0.1",
    "@iobroker/adapter-dev": "^1.5.0",
    "@iobroker/testing": "^6.3.1",
    "@iobroker/types": "^7.2.5",
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.5",
    "@types/proxyquire": "^1.3.31",
    "chai": "^6.3.0",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "mocha": "^12.0.3",
    "proxyquire": "^2.1.3",
    "typescript": "^7.0.2"
  },
  "main": "main.js",
  "files": [
    "admin{,/!(src)/**}/!(tsconfig|tsconfig.*).json",
    "admin{,/!(src)/**}/*.{html,css,png,svg,jpg,js}",
    "lib/",
    "www/",
    "io-package.json",
    "LICENSE",
    "main.js"
  ],
  "scripts": {
    "test:js": "mocha --config test/mocharc.custom.json \"{!(node_modules|test)/**/*.test.js,*.test.js,test/**/test!(PackageFiles|Startup).js}\"",
    "test:package": "mocha test/package --exit",
    "test:integration": "mocha test/integration --exit",
    "test": "npm run test:js && npm run test:package",
    "check": "tsc --noEmit -p tsconfig.check.json",
    "lint": "eslint",
    "translate": "translate-adapter",
    "release": "release-script patch --yes",
    "release-minor": "release-script minor --yes",
    "release-major": "release-script major --yes"
  },
  "bugs": {
    "url": "https://github.com/Azador/ioBroker.epson-esc-vp21/issues"
  },
  "readmeFilename": "README.md"
}
